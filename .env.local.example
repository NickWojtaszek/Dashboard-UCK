# Supabase Configuration (Optional)
# Get these values from https://app.supabase.com/projects
# Leave empty or comment out to use localStorage only

# Your Supabase project URL
REACT_APP_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous key (safe to expose)
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (DO NOT expose, only for backend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
